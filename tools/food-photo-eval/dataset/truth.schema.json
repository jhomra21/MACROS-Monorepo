{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Food photo ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["photoId", "portionSize", "items"],
  "properties": {
    "photoId": { "type": "string" },
    "portionSize": { "type": "string", "enum": ["small", "medium", "large", "not_applicable"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "license", "stratum", "dishTotals"],
      "properties": {
        "dataset": { "type": "string" },
        "license": { "type": "string" },
        "stratum": { "type": "string" },
        "dishTotals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calories", "massGrams", "fatGrams", "carbGrams", "proteinGrams"],
          "properties": {
            "calories": { "type": "number" },
            "massGrams": { "type": "number" },
            "fatGrams": { "type": "number" },
            "carbGrams": { "type": "number" },
            "proteinGrams": { "type": "number" }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "grams", "volumeMl", "preparation", "notes", "foodKey"],
        "properties": {
          "name": { "type": "string" },
          "grams": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "volumeMl": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "preparation": { "type": "string" },
          "notes": { "type": "string" },
          "foodKey": { "type": ["string", "null"] },
          "kcalPerGram": { "type": "number", "minimum": 0, "description": "Optional reference energy density; the scorer prices the item as grams x kcalPerGram instead of looking up CommonFoods." }
        },
        "oneOf": [
          { "properties": { "grams": { "type": "number" }, "volumeMl": { "type": "null" } } },
          { "properties": { "grams": { "type": "null" }, "volumeMl": { "type": "number" } } }
        ]
      }
    }
  }
}