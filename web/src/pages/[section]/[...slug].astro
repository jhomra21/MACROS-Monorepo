---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ArticleBody from '../../components/editorial/ArticleBody.astro';
import PageHeading from '../../components/PageHeading.astro';
import { site } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { absoluteURL, pages, publishedEntries } from '../../lib/seo';
import { socialImage, socialInput } from '../../lib/social';

export async function getStaticPaths() {
	const sections = await Promise.all((['guides', 'blog'] as const).map(async section => {
		const entries = await publishedEntries(section);

		if (entries.length === 0) return [];

		return [
			{ params: { section, slug: undefined }, props: { section, entries } },
			...entries.map(entry => ({ params: { section, slug: entry.id }, props: { section, entry, entries } })),
		];
	}));

	return sections.flat();
}

interface Props {
	section: 'guides' | 'blog';
	entry?: CollectionEntry<'guides' | 'blog'>;
	entries: CollectionEntry<'guides' | 'blog'>[];
}

const { section, entry, entries } = Astro.props;

const sectionName = section === 'guides' ? 'Guides' : 'Blog';

const rendered = entry ? await render(entry) : undefined;

const headings = rendered?.headings.filter(heading => heading.depth === 2) ?? [];

const readingMinutes = entry ? Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).length / 200)) : 0;

const metadata = entry ? { title: entry.data.title, description: entry.data.description } : pages[`/${section}/`];

const articleSchema = entry ? [{
	'@type': 'Article',
	headline: entry.data.title,
	description: entry.data.description,
	datePublished: entry.data.published.toISOString(),
	dateModified: entry.data.updated.toISOString(),
	author: { '@type': 'Person', name: site.author, url: absoluteURL('/about/') },
	image: absoluteURL(socialImage(await socialInput(
		`/${section}/${entry.id}/`, entry.data.title, entry.data.description, entry.data.image,
	)).src),
	mainEntityOfPage: absoluteURL(`/${section}/${entry.id}/`),
}] : [];

const dateText = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const Content = rendered?.Content;
---
<SiteLayout {...metadata}
	article={entry ? { published: entry.data.published, updated: entry.data.updated } : undefined}
	structuredData={articleSchema}>
	<article class="container editorial">
		<nav class="breadcrumbs caption" aria-label="Breadcrumb">
			<a href="/">MACROS</a><span aria-hidden="true"> / </span>
			{entry ? <><a href={`/${section}/`}>{sectionName}</a><span aria-hidden="true"> / </span><span aria-current="page">{entry.data.title}</span></> : <span aria-current="page">{sectionName}</span>}
		</nav>
		<div class="editorial__header">
			<PageHeading heading={entry?.data.title ?? sectionName} lede={metadata.description}>
				{entry && <p class="caption">By <a href="/about/">{site.author}</a><br />
					Published <time datetime={entry.data.published.toISOString()}>{dateText(entry.data.published)}</time>. Updated <time datetime={entry.data.updated.toISOString()}>{dateText(entry.data.updated)}</time>. About {readingMinutes} minutes to read.
				</p>}
			</PageHeading>
		</div>
		{Content ? <>
			{section === 'guides' && headings.length > 3 && <nav class="article-toc" aria-label="On this page">
				<h2 class="title">On this page</h2>
				<ul>{headings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
			</nav>}
			<div class="prose"><ArticleBody><Content /></ArticleBody></div>
			{entry && !entry.body?.includes('<!-- visual:settings -->') && <figure class="editorial__screenshot" data-reveal>
				<Image src={entry.data.image} alt={entry.data.imageAlt} width={320} layout="constrained" widths={[320, 640, 960]} sizes="(max-width: 360px) calc(100vw - 40px), 320px" format="webp" loading="lazy" />
				<figcaption class="caption">{entry.data.imageCaption ?? entry.data.imageAlt}</figcaption>
			</figure>}
			<p class="editorial__related" data-reveal><a href={`/${section}/`}>More {sectionName.toLowerCase()}</a> · <a href="/support/">Get help with MACROS</a> · <a href="/privacy/">How your food diary stays private</a></p>
		</> : <ul class="editorial__list">
			{entries.sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).map(item => <li data-reveal>
				<h2 class="title"><a href={`/${section}/${item.id}/`}>{item.data.title}</a></h2>
				<p>{item.data.description}</p>
				<p class="caption"><time datetime={item.data.updated.toISOString()}>Updated {dateText(item.data.updated)}</time></p>
			</li>)}
		</ul>}
	</article>
</SiteLayout>
