---
export const prerender = true;

import DemoVideo from '../components/DemoVideo.astro';
import FAQ from '../components/FAQ.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Hero from '../components/Hero.astro';
import ProPlans from '../components/ProPlans.astro';
import Showcase from '../components/Showcase.astro';
import WaitlistCta from '../components/WaitlistCta.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { homeStructuredData, pages } from '../lib/seo';
---

<SiteLayout {...pages['/']} structuredData={homeStructuredData}>
	<Hero />
	<FeatureGrid />
	<DemoVideo />
	<Showcase />
	<ProPlans />
	<FAQ />
	<section class="section section--soft">
		<div class="container">
			<div class="section-heading">
				<h2 class="headline">Not sure where to set your goals?</h2>
				<p class="lead">Here's how the app works them out.</p>
				<p><a href="/guides/how-to-set-macro-goals/">Read the macro goals guide</a></p>
			</div>
		</div>
	</section>
	<div id="waitlist">
		<WaitlistCta idPrefix="home" />
	</div>
</SiteLayout>
