---
export const prerender = true;

import WaitlistCta from '../components/WaitlistCta.astro';
import PageHeading from '../components/PageHeading.astro';
import { site } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { organizationStructuredData, pages } from '../lib/seo';

---

<SiteLayout {...pages['/about/']} structuredData={[organizationStructuredData]}>
	<section class="page-header">
		<div class="container">
			<PageHeading heading="A food diary you can just open.">
				<p class="lead">
					MACROS is an iPhone calorie and macro tracker. Log what you ate, check your day, and
					get back to it. <a href="/privacy/">Your diary stays on your phone</a>.
				</p>
			</PageHeading>
		</div>
	</section>

	<section class="section about-story" aria-label="The story">
		<div class="container about-grid">
			<article class="about-item">
				<h2 class="title">Why it exists</h2>
				<p>
					Tracking should be fast and trustworthy. MACROS needs no sign-up and shows
					every number.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">How you log</h2>
				<p>
					Search for a food, or scan its barcode or nutrition label with one camera view.
					Manual entry is always there when a scan fails.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">What you review</h2>
				<p>
					Check <a href="/blog/serving-size-vs-whole-package/">serving size</a>, quantity, calories, protein, carbs, and fat before you
					log a food.
				</p>
			</article>
		</div>
	</section>

	<section class="section" aria-label="Medical advice and corrections">
		<div class="container about-grid">
			<article class="about-item">
				<h2 class="title">Not medical advice</h2>
				<p>
					MACROS and its guides share general information for healthy adults. They are not medical
					advice, and no dietitian or doctor reviews them. Ask a qualified professional about your own
					diet or health.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">Corrections</h2>
				<p>
					Found a mistake? Email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a> or use
					the <a href="/support/">support form</a>, and name the page. Corrections go on the page, and its Updated date changes.
				</p>
			</article>
		</div>
	</section>

	<section class="section section--soft" aria-labelledby="principles-title">
		<div class="container">
			<div class="section-heading">
				<h2 id="principles-title" class="headline">Principles</h2>
			</div>
			<ul class="principles">
				<li>No login to start tracking.</li>
				<li>Your log is stored on your device.</li>
				<li>Every nutrition value is editable when the source data is incomplete.</li>
				<li>Daily totals come only from what you logged.</li>
			</ul>
			<p class="about-next">Read the <a href="/learn/">guides and blog</a>, or see <a href="/#plans">what MACROS Pro adds</a>.</p>
		</div>
	</section>

	<WaitlistCta idPrefix="about" />
</SiteLayout>
