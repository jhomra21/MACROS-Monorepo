---
export const prerender = true;

import WaitlistCta from '../components/WaitlistCta.astro';
import PageHeading from '../components/PageHeading.astro';
import FeatureGlyph from '../components/FeatureGlyph.astro';
import MacroRings from '../components/MacroRings.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../lib/seo';
---

<SiteLayout {...pages['/about/']}>
	<section class="page-header">
		<div class="container">
			<PageHeading heading="Simple, accurate daily tracking.">
				<p class="lead">
					MACROS: Nutrition Tracker is the App Store name. In the app it is MACROS, an iPhone calorie and macro tracker that
					stores your log on the device.
				</p>
			</PageHeading>
		</div>
	</section>

	<section class="section" aria-label="The story">
		<div class="container about-grid">
			<article class="about-card bento__card--protein" data-reveal>
				<FeatureGlyph glyph="device" />
				<h2 class="title">Why it exists</h2>
				<p>I am Juan Ramon Martinez Bulnes, the developer of MACROS.</p>
				<p>
					Tracking should be fast and trustworthy. MACROS needs no sign-up and shows
					every number.
				</p>
			</article>

			<article class="about-card bento__card--carbs" data-reveal style="--reveal-index: 1">
				<FeatureGlyph glyph="scan" />
				<h2 class="title">Core inputs</h2>
				<p>
					One camera view reads barcodes and nutrition labels. Manual entry is always
					there when a scan fails.
				</p>
			</article>

			<article class="about-card bento__card--fat" data-reveal style="--reveal-index: 2">
				<FeatureGlyph glyph="review" />
				<h2 class="title">What you review</h2>
				<p>
					Check serving size, quantity, calories, protein, carbs, and fat before an
					entry joins your day.
				</p>
			</article>
		</div>
	</section>

	<section class="section section--soft" aria-labelledby="principles-title">
		<div class="container">
			<div class="section-heading" data-reveal>
				<MacroRings class="section-rings" />
				<h2 id="principles-title" class="headline">Principles</h2>
			</div>
			<ul class="principles" data-reveal>
				<li>No login to start tracking.</li>
				<li>Your log is stored on your device.</li>
				<li>Every nutrition value is editable when the source data is incomplete.</li>
				<li>Daily totals come only from what you logged.</li>
			</ul>
		</div>
	</section>

	<WaitlistCta idPrefix="about" />
</SiteLayout>
