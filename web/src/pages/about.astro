---
export const prerender = true;

import WaitlistCta from '../components/WaitlistCta.astro';
import PageHeading from '../components/PageHeading.astro';
import { site } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages, personStructuredData } from '../lib/seo';

/*
 * TODO(owner): the "Why it exists" item holds only facts already public on this site. Add, in your own words:
 * - Your background: what you do and where you work from.
 * - Why you built MACROS.
 * - Your own experience tracking food or training.
 * - Optional: a photo of yourself, and the same photo as `image` on the Person schema in src/lib/seo.ts.
 * Add nothing you would not want public. Remove this comment when done.
 */
---

<SiteLayout {...pages['/about/']} structuredData={[personStructuredData]}>
	<section class="page-header">
		<div class="container">
			<PageHeading heading="A food diary you can just open.">
				<p class="lead">
					MACROS is an iPhone calorie and macro tracker. Log what you ate, check your day, and
					get back to it. Your diary stays on your phone.
				</p>
			</PageHeading>
		</div>
	</section>

	<section class="section" aria-label="The story">
		<div class="container about-grid">
			<article class="about-item" id={site.authorSlug}>
				<h2 class="title">Why it exists</h2>
				<p>
					I am {site.author}, the developer of MACROS. I write the guides and posts
					on this site. You can find me on <a href={site.instagramURL}>Instagram</a>.
				</p>
				<p>
					Tracking should be fast and trustworthy. MACROS needs no sign-up and shows
					every number.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">Core inputs</h2>
				<p>
					One camera view reads barcodes and nutrition labels. Manual entry is always
					there when a scan fails.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">What you review</h2>
				<p>
					Check serving size, quantity, calories, protein, carbs, and fat before an
					entry joins your day.
				</p>
			</article>
		</div>
	</section>

	<section class="section" aria-label="How this site is written">
		<div class="container about-grid">
			<article class="about-item">
				<h2 class="title">How posts are made</h2>
				<p>
					I write every guide and post myself. I check each app claim against the
					current build and date the check. Health and nutrition figures come from
					primary sources, and I link them. AI tools help me draft and edit. I check
					every fact before it goes live.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">What I am not</h2>
				<p>
					I am not a dietitian or a doctor. MACROS and its guides give general
					information for healthy adults, not medical advice. Ask a qualified
					professional about your own diet or health.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">Corrections</h2>
				<p>
					Found a mistake? Email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
					and name the page. I fix errors and update the page date when I do.
				</p>
			</article>
		</div>
	</section>

	<section class="section section--soft" aria-labelledby="principles-title">
		<div class="container">
			<div class="section-heading">
				<h2 id="principles-title" class="headline">Principles</h2>
			</div>
			<ul class="principles">
				<li>No login to start tracking.</li>
				<li>Your log is stored on your device.</li>
				<li>Every nutrition value is editable when the source data is incomplete.</li>
				<li>Daily totals come only from what you logged.</li>
			</ul>
		</div>
	</section>

	<WaitlistCta idPrefix="about" />
</SiteLayout>
