---
export const prerender = true;

import WaitlistCta from '../components/WaitlistCta.astro';
import PageHeading from '../components/PageHeading.astro';
import { site } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages, personStructuredData } from '../lib/seo';

---

<SiteLayout {...pages['/about/']} structuredData={[personStructuredData]}>
	<section class="page-header">
		<div class="container">
			<PageHeading heading="A food diary you can just open.">
				<p class="lead">
					MACROS is an iPhone calorie and macro tracker. Log what you ate, check your day, and
					get back to it. Your diary stays on your phone.
				</p>
			</PageHeading>
		</div>
	</section>

	<section class="section" aria-label="The story">
		<div class="container about-grid">
			<article class="about-item" id={site.authorSlug}>
				<h2 class="title">Why it exists</h2>
				<p>I am {site.author}, the developer of MACROS.</p>
				<p>
					Tracking should be fast and trustworthy. MACROS needs no sign-up and shows
					every number.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">Core inputs</h2>
				<p>
					One camera view reads barcodes and nutrition labels. Manual entry is always
					there when a scan fails.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">What you review</h2>
				<p>
					Check serving size, quantity, calories, protein, carbs, and fat before an
					entry joins your day.
				</p>
			</article>
		</div>
	</section>

	<section class="section" aria-label="Medical advice and corrections">
		<div class="container about-grid">
			<article class="about-item">
				<h2 class="title">Not medical advice</h2>
				<p>
					MACROS and its guides give general information for healthy adults. I am not
					a dietitian or a doctor. Ask a qualified professional about your own diet or
					health.
				</p>
			</article>

			<article class="about-item">
				<h2 class="title">Corrections</h2>
				<p>
					Found a mistake? Email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
					and name the page. I fix errors and update the page date when I do.
				</p>
			</article>
		</div>
	</section>

	<section class="section section--soft" aria-labelledby="principles-title">
		<div class="container">
			<div class="section-heading">
				<h2 id="principles-title" class="headline">Principles</h2>
			</div>
			<ul class="principles">
				<li>No login to start tracking.</li>
				<li>Your log is stored on your device.</li>
				<li>Every nutrition value is editable when the source data is incomplete.</li>
				<li>Daily totals come only from what you logged.</li>
			</ul>
		</div>
	</section>

	<WaitlistCta idPrefix="about" />
</SiteLayout>
