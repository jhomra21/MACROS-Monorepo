---
import MacroRings from './MacroRings.astro';

interface Props {
	heading: string;
	lede?: string;
}

const { heading, lede } = Astro.props;
---

<header class="section-heading page-heading">
	<MacroRings class="section-rings" />
	<h1 class="page-title">{heading}</h1>
	{lede && <p class="lead">{lede}</p>}
	<slot />
</header>
