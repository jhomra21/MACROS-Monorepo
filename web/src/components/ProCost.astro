---
import { site } from '../data/site';

// Read from the plan list so the chart and the prices above it share one source. Work in cents to keep sums exact.
const cents = (name: string) => {
	const option = site.proPrices.find(item => item.name === name);

	if (!option) throw new Error(`No ${name} price in site.proPrices`);

	const value = Number(option.price.replace('$', ''));

	if (!Number.isFinite(value)) throw new Error(`${name} price is not a plain dollar amount: ${option.price}`);

	return Math.round(value * 100);
};

const monthly = cents('Monthly');

const yearly = cents('Yearly');

const lifetime = cents('Lifetime');

const years = [1, 2, 3];

const twelveMonths = monthly * 12;

const saved = twelveMonths - yearly;

// First whole year or month in which a renewing plan's running total passes the one-time price.
const passes = (price: number) => Array.from({ length: 100 }, (_, index) => index + 1).find(count => count * price > lifetime);

const plans = [
	{ name: 'Monthly', detail: `${dollars(twelveMonths)} a year`, totals: years.map(year => year * twelveMonths), renews: twelveMonths },
	{ name: 'Yearly', detail: `${dollars(yearly)} a year`, totals: years.map(year => year * yearly), renews: yearly },
	{ name: 'Lifetime', detail: 'Paid once', totals: years.map(() => lifetime), renews: 0 },
];

const top = Math.max(...plans.flatMap(plan => plan.totals));

const at = (value: number) => `${(value / top) * 100}%`;

function dollars(value: number) {
	return `$${(value / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
---
<figure class="guide-diagram pro-cost" aria-labelledby="pro-cost-caption" style={`--lifetime: ${at(lifetime)}`}>
	<p class="title">What each plan costs over {years.length} years</p>
	<div class="pro-cost__math">
		<p><span>Yearly, about {dollars(Math.round(yearly / 12))} a month</span> <strong>{dollars(yearly)} billed yearly</strong></p>
		<p><span>Monthly, 12 × {dollars(monthly)}</span> <strong>{dollars(twelveMonths)} a year</strong></p>
	</div>
	<ul class="pro-cost__plans" role="list">
		{plans.map(plan => <li>
			<p class="pro-cost__name"><strong>{plan.name}</strong> <span class="caption">{plan.detail}</span></p>
			<span class="pro-cost__track" aria-hidden="true">
				<span class="diagram-bar" style={`--share: ${at(plan.totals.at(-1)!)}`}></span>
				{plan.renews > 0 && plan.totals.slice(0, -1).map(total => <i style={`left: ${at(total)}`}></i>)}
			</span>
			<p class="caption">{plan.renews > 0
				? plan.totals.map((total, index) => <span>{index + 1} {index === 0 ? 'year' : 'years'} <strong>{dollars(total)}</strong></span>)
				: <><span>Once <strong>{dollars(lifetime)}</strong></span><span>No renewals</span></>}</p>
		</li>)}
	</ul>
	<figcaption id="pro-cost-caption" class="caption">Yearly costs {dollars(saved)} less than 12 monthly payments, about {Math.round((saved / twelveMonths) * 100)}% less. The dashed line marks Lifetime's {dollars(lifetime)}. Yearly's running total passes it in year {passes(yearly)}, and Monthly's in month {passes(monthly)}. US prices from the list above, assuming they stay the same and the plan renews without a break.</figcaption>
</figure>

<style>
	.pro-cost__math p {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 var(--space-3);
		padding-block: var(--space-2);
		border-bottom: 1px solid var(--hairline);
		font-size: var(--fs-small);
	}

	.pro-cost__plans {
		display: grid;
		gap: var(--space-4);
	}

	.pro-cost__plans li {
		display: grid;
		gap: var(--space-2);
	}

	.pro-cost__name {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 var(--space-3);
	}

	/* Band-colored cuts split a renewing plan's bar into one block per year. The dashed line is Lifetime's price. */
	.pro-cost__track {
		position: relative;
		display: block;
		height: 0.75rem;
		border-radius: var(--radius-pill);
		background: color-mix(in srgb, var(--ink) 12%, transparent);
	}

	.pro-cost__track .diagram-bar {
		height: 100%;
	}

	.pro-cost__track i {
		position: absolute;
		inset-block: 0;
		width: 3px;
		background: var(--band);
		transform: translateX(-50%);
	}

	.pro-cost__track::after {
		content: '';
		position: absolute;
		inset-block: -0.25rem;
		left: var(--lifetime);
		border-left: 2px dashed var(--ink-muted);
		transform: translateX(-50%);
	}

	.pro-cost__plans .caption {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--space-4);
	}

	.pro-cost__plans .caption strong {
		color: var(--ink);
		font-weight: 600;
	}
</style>
