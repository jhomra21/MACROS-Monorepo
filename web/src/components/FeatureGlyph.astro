---
export type Glyph = 'rings' | 'scan' | 'device' | 'review' | 'people' | 'widget';

interface Props {
	glyph: Glyph;
}

const { glyph } = Astro.props;

// Each viewBox hugs its drawing so the glyph's left edge lines up with the card text.
const viewBoxes: Record<Glyph, string> = {
	rings: '28 4 88 88',
	scan: '4 8 134 80',
	device: '46 2 52 92',
	review: '12 6 120 84',
	people: '6 8 132 80',
	widget: '6 2 132 92',
};
---

<svg class="glyph" viewBox={viewBoxes[glyph]} fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	{
		glyph === 'rings' && (
			<g transform="rotate(-90 72 48)" stroke-width="7">
				<circle class="g-track" cx="72" cy="48" r="40" />
				<circle class="g-protein" cx="72" cy="48" r="40" stroke-dasharray="196 252" />
				<circle class="g-track" cx="72" cy="48" r="28" />
				<circle class="g-carbs" cx="72" cy="48" r="28" stroke-dasharray="132 176" />
				<circle class="g-track" cx="72" cy="48" r="16" />
				<circle class="g-fat" cx="72" cy="48" r="16" stroke-dasharray="64 101" />
			</g>
		)
	}
	{
		glyph === 'scan' && (
			<>
				<g class="g-accent-fill">
					<rect x="10" y="22" width="4" height="52" rx="1" />
					<rect x="18" y="22" width="8" height="52" rx="1" />
					<rect x="30" y="22" width="3" height="52" rx="1" />
					<rect x="37" y="22" width="6" height="52" rx="1" />
					<rect x="47" y="22" width="3" height="52" rx="1" />
					<rect x="54" y="22" width="7" height="52" rx="1" />
				</g>
				<path class="g-accent" stroke-width="2" d="M4 48h64" />
				<rect class="g-muted" x="76" y="10" width="60" height="76" rx="8" stroke-width="2" />
				<path class="g-muted" stroke-width="2" d="M86 26h24M86 38h40M86 50h40M86 62h28M86 74h20" />
			</>
		)
	}
	{
		glyph === 'device' && (
			<>
				<rect class="g-accent" x="48" y="4" width="48" height="88" rx="12" stroke-width="2" />
				<path class="g-muted" stroke-width="2" d="M64 12h16" />
				<circle class="g-accent-fill g-soft" cx="72" cy="48" r="20" />
				<circle class="g-accent-fill" cx="72" cy="48" r="7" />
				<path class="g-muted" stroke-width="2" d="M60 78h24" />
			</>
		)
	}
	{
		glyph === 'review' && (
			<>
				<rect class="g-muted" x="14" y="8" width="116" height="80" rx="10" stroke-width="2" />
				<circle class="g-protein-fill" cx="32" cy="32" r="4" />
				<path class="g-muted" stroke-width="2" d="M44 32h40" />
				<circle class="g-carbs-fill" cx="32" cy="48" r="4" />
				<path class="g-muted" stroke-width="2" d="M44 48h52" />
				<circle class="g-fat-fill" cx="32" cy="64" r="4" />
				<path class="g-muted" stroke-width="2" d="M44 64h30" />
				<circle class="g-accent-fill" cx="112" cy="68" r="14" />
				<path stroke="#fff" stroke-width="3" d="m105 68 5 5 9-10" />
			</>
		)
	}
	{
		glyph === 'people' && (
			<>
				<rect class="g-accent-fill g-soft" x="8" y="10" width="128" height="34" rx="12" />
				<circle class="g-accent-fill" cx="30" cy="27" r="9" />
				<path class="g-muted" stroke-width="2" d="M48 27h30" />
				<rect class="g-accent-fill" x="92" y="21" width="32" height="12" rx="6" />
				<rect class="g-accent-fill g-soft" x="8" y="52" width="128" height="34" rx="12" />
				<circle class="g-accent-fill" cx="30" cy="69" r="9" />
				<path class="g-muted" stroke-width="2" d="M48 69h22" />
				<rect class="g-accent-fill" x="84" y="63" width="40" height="12" rx="6" />
			</>
		)
	}
	{
		glyph === 'widget' && (
			<>
				<rect class="g-accent-fill g-soft" x="8" y="4" width="128" height="50" rx="14" />
				<rect class="g-accent" x="8" y="4" width="128" height="50" rx="14" stroke-width="2" />
				<circle class="g-track" cx="36" cy="29" r="14" stroke-width="5" />
				<circle class="g-accent" cx="36" cy="29" r="14" stroke-width="5" stroke-dasharray="58 88" transform="rotate(-90 36 29)" />
				<path class="g-muted" stroke-width="2" d="M62 22h56M62 36h36" />
				<rect class="g-accent-fill g-soft" x="8" y="62" width="34" height="30" rx="10" />
				<circle class="g-accent" cx="75" cy="77" r="15" stroke-width="2" />
				<circle class="g-accent-fill" cx="75" cy="77" r="6" />
				<circle class="g-muted" cx="120" cy="77" r="15" stroke-width="2" />
			</>
		)
	}
</svg>
