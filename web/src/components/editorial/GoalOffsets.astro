---
// Paces and offsets match GoalDirection and BodyProfileDraft.offset in the app: 1,000 kcal a day per kg a week, gain capped at +500.
// Maintenance is the guide's worked example.
const kgPerLb = 0.45359237;

const maintenance = (10 * 70 + 6.25 * 175 - 5 * 30 + 5) * 1.55;

const floors = { male: 1500, other: 1200 };

const axis = { low: 1000, high: 3500, ticks: [1000, 2000, 3000] };

const pace = (kg: number) => `${kg} kg (${(kg / kgPerLb).toFixed(2)} lb) a week`;

const rows = [
	...[0.5, 0.25].map(kg => ({ name: 'Gain', detail: pace(kg), offset: Math.min(500, kg * 1000) })),
	{ name: 'Maintain', detail: 'No offset', offset: 0 },
	...[0.25, 0.5, 0.75].map(kg => ({ name: 'Lose', detail: pace(kg), offset: -kg * 1000 })),
].map(row => ({ ...row, target: maintenance + row.offset }));

const at = (kcal: number) => ((kcal - axis.low) / (axis.high - axis.low)) * 100;

const kcal = (value: number, digits = 2) => value.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });

const signed = (value: number) => (value === 0 ? '0' : `${value < 0 ? '−' : '+'}${kcal(Math.abs(value), 0)}`);
---
<figure class="guide-diagram goal-offsets" data-diagram aria-labelledby="goal-offsets-caption" style={`--maintenance: ${at(maintenance)}%; --floor-male: ${at(floors.male)}%; --floor-other: ${at(floors.other)}%`}>
	<p class="title">Goal offsets and calorie floors</p>
	<div class="goal-offsets__body">
		<ul class="goal-offsets__legend caption" role="list">
			<li><i class="goal-offsets__swatch" aria-hidden="true"></i>{kcal(floors.male, 0)} kcal floor for Male</li>
			<li><i class="goal-offsets__swatch goal-offsets__swatch--other" aria-hidden="true"></i>{kcal(floors.other, 0)} kcal floor for Female and Unspecified</li>
		</ul>
		<ul class="goal-offsets__rows" role="list">
			{rows.map(row => <li class:list={{ 'goal-offsets__maintain': row.offset === 0 }}>
				<p><strong>{row.name}</strong><span class="caption">{row.detail}</span></p>
				<span class="goal-offsets__track" aria-hidden="true">
					{row.offset !== 0 && <span class="goal-offsets__bar" style={`left: ${at(Math.min(row.target, maintenance))}%; width: ${(Math.abs(row.offset) / (axis.high - axis.low)) * 100}%`}></span>}
					<i style={`left: ${at(row.target)}%`}></i>
				</span>
				<p class="goal-offsets__numbers"><strong>{kcal(row.target)} kcal</strong><span class="caption">{signed(row.offset)}<span class="sr-only"> kcal a day</span></span></p>
			</li>)}
		</ul>
		<div class="goal-offsets__axis" aria-hidden="true">
			<span>{axis.ticks.map(tick => <b style={`left: ${at(tick)}%`}>{kcal(tick, 0)}</b>)}</span>
		</div>
	</div>
	<figcaption id="goal-offsets-caption" class="caption">Offsets applied to the worked example's maintenance estimate of 2,555.56 kcal. Every option stays above both floors. A requested target below its floor is raised to the floor and flagged.</figcaption>
</figure>

<style>
	.goal-offsets__body {
		container-type: inline-size;
	}

	.goal-offsets__body > * + * {
		margin-top: var(--space-3);
	}

	:global(.editorial .prose) .goal-offsets__legend {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		padding-left: 0;
		list-style: none;
	}

	.goal-offsets__legend li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: 0;
	}

	/* The 1,500 floor is a solid line and the 1,200 floor a dashed one, in the legend and the chart. */
	.goal-offsets__swatch {
		display: inline-block;
		width: 0;
		height: 1.25em;
		border-left: 2px solid var(--ink);
	}

	.goal-offsets__swatch--other {
		border-left-style: dashed;
	}

	:global(.editorial .prose) .goal-offsets__rows {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: var(--space-4);
		padding-left: 0;
		list-style: none;
		font-size: var(--fs-small);
	}

	.goal-offsets__rows li {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: center;
		margin-top: 0;
	}

	.goal-offsets__rows p {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 var(--space-2);
		padding-block: var(--space-2);
	}

	.goal-offsets__numbers {
		grid-row: 1;
		grid-column: 2;
		flex-direction: column;
		align-items: end;
		white-space: nowrap;
	}

	.goal-offsets__maintain p strong {
		font-weight: 800;
	}

	/* Tracks in neighboring rows touch, so the floors and the maintenance guide read as continuous lines. */
	.goal-offsets__track,
	.goal-offsets__axis > span {
		position: relative;
		display: block;
		margin-inline: 0.375rem;
	}

	.goal-offsets__track {
		grid-row: 2;
		grid-column: 1 / -1;
		align-self: stretch;
		min-height: 1.5rem;
		background: linear-gradient(var(--hairline) 0 0) var(--maintenance) 0 / 1px 100% no-repeat;
	}

	.goal-offsets__track::before,
	.goal-offsets__track::after {
		content: '';
		position: absolute;
		inset-block: 0;
		margin-left: -1px;
		border-left: 2px solid var(--ink);
	}

	.goal-offsets__track::before {
		left: var(--floor-male);
	}

	.goal-offsets__track::after {
		left: var(--floor-other);
		border-left-style: dashed;
	}

	.goal-offsets__bar {
		position: absolute;
		top: 50%;
		height: 0.375rem;
		border-radius: var(--radius-pill);
		background: var(--ink-muted);
		transform: translateY(-50%);
	}

	.goal-offsets__track i {
		position: absolute;
		top: 50%;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--ink);
		transform: translate(-50%, -50%);
	}

	.goal-offsets__maintain .goal-offsets__track i {
		width: 1rem;
		height: 1rem;
		border: 3px solid var(--ink);
		background: var(--band);
	}

	.goal-offsets__axis > span {
		height: 1.75rem;
		border-top: 1px solid var(--ink-muted);
		color: var(--ink-muted);
		font-size: var(--fs-caption);
	}

	.goal-offsets__axis b {
		position: absolute;
		top: var(--space-1);
		font-weight: 400;
		transform: translateX(-50%);
	}

	.goal-offsets__axis b:first-child {
		transform: none;
	}

	@container (min-width: 32rem) {
		:global(.editorial .prose) .goal-offsets__rows,
		.goal-offsets__axis {
			display: grid;
			grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) 7rem;
			column-gap: var(--space-4);
		}

		.goal-offsets__track {
			grid-row: 1;
			grid-column: 2;
		}

		.goal-offsets__numbers {
			grid-column: 3;
		}

		.goal-offsets__axis > span {
			grid-column: 2;
		}
	}

	/* With large text on a narrow screen the numbers keep the room and the chart goes. */
	@container (max-width: 14rem) {
		.goal-offsets__swatch,
		.goal-offsets__track,
		.goal-offsets__axis {
			display: none;
		}

		:global(.editorial .prose) .goal-offsets__rows {
			grid-template-columns: minmax(0, 1fr);
		}

		.goal-offsets__rows li {
			border-top: 1px solid var(--hairline);
		}

		.goal-offsets__numbers {
			grid-row: auto;
			grid-column: 1;
			align-items: start;
			padding-top: 0;
		}
	}
</style>
