---
// The post's made-up protein bar, from plain 4-4-9 to the printed label.
const bar = { protein: 20, carbs: 24, fat: 7, solubleFiber: 10, erythritol: 8 };

const plain = bar.protein * 4 + bar.carbs * 4 + bar.fat * 9;

// Under the fiber method, soluble fiber counts 2 instead of 4 and erythritol 0 instead of 4.
const fiberCut = bar.solubleFiber * (4 - 2);

const erythritolCut = bar.erythritol * (4 - 0);

const exact = plain - fiberCut - erythritolCut;

// Above 50 calories, labels round to the nearest 10.
const printed = Math.round(exact / 10) * 10;

const steps = [
	{ name: 'Plain 4‑4‑9', detail: `All ${bar.carbs} g of carbs at 4`, from: 0, to: plain, value: `${plain}`, kind: 'total' },
	{ name: 'Soluble fiber', detail: `${bar.solubleFiber} g counted at 2, not 4`, from: plain - fiberCut, to: plain, value: `−${fiberCut}`, kind: 'cut' },
	{ name: 'Erythritol', detail: `${bar.erythritol} g counted at 0, not 4`, from: exact, to: plain - fiberCut, value: `−${erythritolCut}`, kind: 'cut' },
	{ name: "Maker's total", detail: 'Before rounding', from: 0, to: exact, value: `${exact}`, kind: 'total' },
	{ name: 'Rounding', detail: 'Nearest 10 above 50', from: exact, to: printed, value: `+${printed - exact}`, kind: 'add' },
	{ name: 'Printed label', detail: 'The number to log', from: 0, to: printed, value: `${printed}`, kind: 'total' },
];

const share = (value: number) => `${(value / plain) * 100}%`;
---
<figure class="guide-diagram bar-steps" data-diagram aria-labelledby="bar-steps-caption">
	<p class="title">Protein bar, from {plain} to {printed}</p>
	<ol class="bar-steps__list" role="list">
		{steps.map(step => <li class={`bar-steps__${step.kind}`}>
			<p class="bar-steps__name"><span>{step.name}</span><span class="caption">{step.detail}</span></p>
			<strong class="bar-steps__value">{step.value}<span class="sr-only"> calories</span></strong>
			<span class="bar-steps__track" aria-hidden="true"><span class="bar-steps__bar" style={`--from: ${share(step.from)}; --to: ${share(step.to)}`}></span></span>
		</li>)}
	</ol>
	<figcaption id="bar-steps-caption" class="caption">The method removes {fiberCut + erythritolCut} calories and rounding adds {printed - exact} back, so the label sits {plain - printed} below plain 4‑4‑9. Open bars are calories the method removes. The protein bar is a made-up label, not a real product.</figcaption>
</figure>

<style>
	/* The figure class lifts these above the prose list rules (padding, numbers, li + li margin). */
	.bar-steps .bar-steps__list {
		padding: 0;
		list-style: none;
	}

	/* Each bar gets the full row width under its label, so every bar is measured from the same zero. */
	.bar-steps .bar-steps__list > li {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
		margin: 0;
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--hairline);
	}

	.bar-steps .bar-steps__list > li:first-child {
		padding-top: 0;
	}

	/* Names wrap between words; a value that no longer fits drops to its own line instead of squeezing them. */
	.bar-steps__name {
		flex: 1 1 0;
		overflow-wrap: break-word;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 var(--space-2);
	}

	.bar-steps__value {
		margin-inline-start: auto;
		white-space: nowrap;
	}

	.bar-steps__track {
		display: block;
		flex-basis: 100%;
	}

	.bar-steps__bar {
		display: block;
		/* Rounding adds 3 of 239, about 1%; keep it visible. */
		min-width: 3px;
		width: calc(var(--to) - var(--from));
		height: 0.75em;
		margin-inline-start: var(--from);
		border-radius: 3px;
		background: var(--ink);
	}

	.bar-steps__cut .bar-steps__bar {
		border: 2px solid var(--ink);
		background: none;
	}

	.bar-steps__add .bar-steps__bar {
		background: var(--ink-muted);
	}

	.bar-steps__total .bar-steps__name > :first-child,
	.bar-steps__value {
		font-weight: 600;
	}
</style>
