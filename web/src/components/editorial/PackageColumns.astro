---
// Thresholds from 21 CFR 101.9(b)(6) and (b)(12)(i), as multiples of the 21 CFR 101.12 reference amount.
const scaleEnd = 3.5;

const at = (multiple: number) => `${(multiple / scaleEnd) * 100}%`;

const zones = [
	{ key: 1, from: 0, to: 1.5, tone: 'single' },
	{ key: 2, from: 1.5, to: 2, tone: 'optional' },
	{ key: 3, from: 2, to: 3, tone: 'dual' },
	{ key: 4, from: 3, to: scaleEnd, tone: 'beyond' },
];

const ticks = [0, 1, 1.5, 2, 3];

// Reference amounts from 21 CFR 101.12, with the ounces the post gives.
const foods = [
	{ name: 'Cookies', grams: 30, ounces: 1 },
	{ name: 'Yogurt', grams: 170, ounces: 6 },
];

const largest = Math.max(...foods.map(food => food.grams));
---
<figure class="guide-diagram package-columns" data-diagram aria-labelledby="package-columns-caption">
	<p class="title">Package size sets the label columns</p>
	<div class="package-columns__body">
	<div class="package-columns__chart" aria-hidden="true">
		<p class="caption">Package size as a multiple of the reference amount</p>
		<div class="package-columns__bar">
			{zones.map(zone => <span class:list={['package-columns__zone', `package-columns__zone--${zone.tone}`]} style={`left: ${at(zone.from)}; width: calc(${at(zone.to)} - ${at(zone.from)})`}><span class="diagram-key">{zone.key}</span></span>)}
			{[2, 3].map(boundary => <i class="package-columns__boundary" style={`--at: ${at(boundary)}`}></i>)}
		</div>
		<div class="package-columns__axis caption">
			{ticks.map(tick => <span style={`--at: ${at(tick)}`}>{tick}×</span>)}
		</div>
	</div>
	<ol class="package-columns__zones" role="list">
		<li><span class="diagram-key" aria-hidden="true">1</span><p><strong>Up to 1.5×: one serving.</strong> <span class="caption">A package sold on its own that holds less than twice the reference amount counts as one serving. The label's numbers cover the whole package.</span></p></li>
		<li><span class="diagram-key" aria-hidden="true">2</span><p><strong>Over 1.5×, under 2×: still one serving.</strong> <span class="caption">The main column still covers the whole package. Some labels add a second column for a smaller serving of about 1×. If you ate it all, read the whole-package column.</span></p></li>
		<li><span class="diagram-key" aria-hidden="true">3</span><p><strong>2× to 3×: two columns.</strong> <span class="caption">Counting exactly 2× and 3×. The label must show one column for a serving and one for the whole package. A few foods can skip the second column, such as very small packages and raw fruit, vegetables, and seafood.</span></p></li>
		<li><span class="diagram-key" aria-hidden="true">4</span><p><strong>Over 3×: no package column required.</strong> <span class="caption">The two-column rule stops at 3×. Multiply the per-serving numbers by the servings you ate.</span></p></li>
	</ol>
	<div class="package-columns__foods">
		<p><strong>What 1× means for two foods</strong></p>
		<ul role="list">
			{foods.map(food => <li>
				<p class="package-columns__food"><span>{food.name}</span><span class="diagram-bar" style={`--share: ${(food.grams / largest) * 100}%`} aria-hidden="true"></span><strong>{food.grams}&nbsp;g ({food.ounces}&nbsp;oz)</strong></p>
				<p class="caption">A package under {2 * food.grams}&nbsp;g is one serving. From {2 * food.grams}&nbsp;g to {3 * food.grams}&nbsp;g, it shows two columns.</p>
			</li>)}
		</ul>
	</div>
	</div>
	<figcaption id="package-columns-caption" class="caption">1× is FDA's reference amount: how much of that kind of food people usually eat at one time. These rules cover packages sold on their own. Sources: 21 CFR 101.9(b)(6) and (b)(12)(i), and 21 CFR 101.12 for reference amounts.</figcaption>
</figure>

<style>
	.package-columns .package-columns__body {
		container-type: inline-size;
	}

	.package-columns .package-columns__body > * + * {
		margin-top: var(--space-4);
	}

	.package-columns .package-columns__bar {
		position: relative;
		height: 2rem;
		margin-top: var(--space-2);
	}

	/* Zones read apart by fill pattern and number, not only by shade. */
	.package-columns .package-columns__zone {
		position: absolute;
		inset-block: 0;
		display: grid;
		place-items: center;
		border-radius: var(--radius-sm);
	}

	.package-columns .package-columns__zone--single {
		border-radius: var(--radius-sm) 0 0 var(--radius-sm);
		background: color-mix(in srgb, var(--ink) 30%, var(--band));
	}

	.package-columns .package-columns__zone--optional {
		border-radius: 0;
		background:
			repeating-linear-gradient(-45deg, color-mix(in srgb, var(--ink) 45%, transparent) 0 2px, transparent 2px 6px),
			color-mix(in srgb, var(--ink) 20%, var(--band));
	}

	.package-columns .package-columns__zone--dual {
		border-radius: 0;
		background: var(--ink);
	}

	.package-columns .package-columns__zone--beyond {
		border: 2px dashed color-mix(in srgb, var(--ink) 60%, transparent);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		background: var(--band);
	}

	/* A band-colored gap marks each boundary the rules draw, at 2× and 3×. */
	.package-columns .package-columns__boundary {
		position: absolute;
		inset-block: 0;
		left: var(--at);
		width: 3px;
		background: var(--band);
		transform: translateX(-50%);
	}

	.package-columns .package-columns__axis {
		position: relative;
		height: 1.6em;
		margin-top: var(--space-1);
	}

	.package-columns .package-columns__axis span {
		position: absolute;
		left: var(--at);
		transform: translateX(-50%);
		white-space: nowrap;
	}

	.package-columns .package-columns__axis span:first-child {
		transform: none;
	}

	.package-columns .package-columns__zones,
	.package-columns .package-columns__foods ul {
		display: grid;
		padding-left: 0;
		list-style: none;
	}

	.package-columns .package-columns__zones {
		gap: var(--space-3);
	}

	.package-columns .package-columns__zones li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		margin-top: 0;
	}

	.package-columns .package-columns__zones .caption {
		display: block;
	}

	.package-columns .package-columns__foods {
		padding-top: var(--space-4);
		border-top: 1px solid var(--hairline);
	}

	/* Both rows share the label and value columns, so the bars start at the same x and share one gram scale. */
	.package-columns .package-columns__foods ul {
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.package-columns .package-columns__foods li {
		margin-top: 0;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
	}

	.package-columns .package-columns__food {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: center;
	}

	.package-columns .package-columns__food strong {
		text-align: end;
	}

	.package-columns .package-columns__foods li > .caption {
		grid-column: 1 / -1;
	}

	/* With large text on a narrow screen the scale and bars cannot fit their labels; the numbered list and gram rows carry every value. */
	@container (max-width: 15rem) {
		.package-columns .package-columns__chart,
		.package-columns .package-columns__foods .diagram-bar {
			display: none;
		}

		.package-columns .package-columns__zones li {
			display: block;
		}

		.package-columns .package-columns__zones .diagram-key {
			margin-right: var(--space-2);
			vertical-align: text-bottom;
		}

		.package-columns .package-columns__zones li > p {
			display: inline;
		}

		.package-columns .package-columns__foods ul,
		.package-columns .package-columns__foods li {
			display: block;
		}

		.package-columns .package-columns__food {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0 var(--space-3);
		}
	}
</style>
