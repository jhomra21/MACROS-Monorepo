---
import CalorieFlow from './CalorieFlow.astro';
import AMDRChart from './AMDRChart.astro';
import CalculatorSteps from './CalculatorSteps.astro';
import ServingLabel from './ServingLabel.astro';
import CalorieGap from './CalorieGap.astro';
import ProteinLookup from './ProteinLookup.astro';
import CarbFactors from './CarbFactors.astro';
import LabelRounding from './LabelRounding.astro';
import ProteinBarSteps from './ProteinBarSteps.astro';
import type { ComponentProps } from 'astro/types';
import GuideScreenshot from './GuideScreenshot.astro';
import { visualMarker } from '../../lib/article-visuals';

// Markdown keeps these explicit placement comments. Render the slot first so
// Astro still resolves Markdown assets, then insert static Astro components.
const html = (await Astro.slots.render('default'))
	.replaceAll('<table>', '<div class="table-scroll" role="region" aria-label="Article data table" tabindex="0"><table>')
	.replaceAll('</table>', '</table></div>');

const parts = html.split(visualMarker);
---
{parts.map((part, index) => index % 2 === 0 ? <Fragment set:html={part} /> :
	part === 'calorie-flow' ? <CalorieFlow /> :
	part === 'amdr' ? <AMDRChart /> :
	part === 'calculator' ? <CalculatorSteps /> :
	part === 'serving-label' ? <ServingLabel /> :
	part === 'calorie-gap' ? <CalorieGap /> :
	part === 'protein-lookup' ? <ProteinLookup /> :
	part === 'carb-factors' ? <CarbFactors /> :
	part === 'label-rounding' ? <LabelRounding /> :
	part === 'protein-bar-steps' ? <ProteinBarSteps /> :
	<GuideScreenshot screen={part as ComponentProps<typeof GuideScreenshot>['screen']} />
)}
