---
import { Picture } from 'astro:assets';
import settings from '../../assets/app-images/app-settings.png';
import profile from '../../assets/app-images/app-calculator-profile.png';
import activity from '../../assets/app-images/app-calculator-activity.png';
import review from '../../assets/app-images/app-calculator-review.png';
import scanReview from '../../assets/app-images/app-scan-review.png';
import scanGrams from '../../assets/app-images/app-scan-grams.png';
import scanDetails from '../../assets/app-images/app-scan-details.png';

const images = {
	settings: { src: settings, alt: 'MACROS Settings with editable Daily Goals and Recalculate Targets.', caption: 'Settings > Daily Goals. These demo values show the controls, not the worked example or a recommended diet.' },
	profile: { src: profile, alt: 'Recalculate Targets body profile with Male selected, age 30, height 175 cm, and weight 70 kg.', caption: 'Enter the body profile. This example uses Male, age 30, 175 cm, and 70 kg.' },
	activity: { src: activity, alt: 'Calculator with Moderate activity and Maintain selected under Your goal, above Review targets.', caption: 'Choose Moderate activity and Maintain for this example. Scroll down in the form to find Your goal.' },
	review: { src: review, alt: 'Your targets review with Balanced macro balance, 2,565 kcal, 130 g protein, 320 g carbs, and 85 g fat.', caption: 'Review the targets and Macro balance. This Balanced example matches the calculation above.' },
	'scan-review': { src: scanReview, alt: 'MACROS label scan result for a demo cereal label: 190 kcal, Servings stepper set to 1, 1 cup (40g) each, 40 g total, with Edit details and Log buttons.', caption: 'A label scan of a demo cereal label. The Servings stepper moves in quarter servings and scales calories, macros, and the gram total.' },
	'scan-grams': { src: scanGrams, alt: 'MACROS Edit details for the demo Oat Crunch Cereal label in Grams mode: the Grams stepper at 60 g, 285 kcal, P 7.5, C 54, F 4.5, and a serving size of 1 cup (40g).', caption: 'Edit details in Grams mode. At 60 g, MACROS scales the 40 g serving by 1.5, so 190 kcal becomes 285 kcal.' },
	'scan-details': { src: scanDetails, alt: 'MACROS scan details for a demo cereal label showing 190 kcal, P 5, C 36, F 3, a Servings and Grams switch, and editable food name and serving size.', caption: 'MACROS keeps the label\'s calorie number. On this demo label, 4 × 5 + 4 × 36 + 9 × 3 = 191, which rounds to the printed 190.' },
};

interface Props { screen: keyof typeof images }

const image = images[Astro.props.screen];
---
<figure class="editorial__screenshot">
	<Picture src={image.src} alt={image.alt} width={320} layout="constrained" widths={[320, 640, 960]}
		sizes="(max-width: 360px) calc(100vw - 40px), 320px" formats={['avif']} fallbackFormat="webp" loading="lazy" />
	<figcaption class="caption">{image.caption}</figcaption>
</figure>
