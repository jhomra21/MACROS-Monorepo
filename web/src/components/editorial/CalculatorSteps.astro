---
const steps = [
	{ title: 'Resting estimate', value: '1,648.75 kcal', detail: '10 × 70 + 6.25 × 175 − 5 × 30 + 5' },
	{ title: 'Moderate activity', value: '2,555.56 kcal', detail: '1,648.75 × 1.55' },
	{ title: 'Maintain', value: '+0 kcal', detail: 'No goal offset. The result is above the calorie floor.' },
	{ title: 'Balanced split', value: '30% / 40% / 30%', detail: 'Protein 191.67 g, carbs 255.56 g, fat 85.19 g before rounding.' },
	{ title: 'Round and adjust', value: '2,565 kcal', detail: '190 g protein, 260 g carbs, 85 g fat. Carbs rise from 255 g to reach the estimate.' },
];
---
<figure class="guide-diagram" data-diagram aria-labelledby="calculator-caption">
	<p class="title">How this example reaches 2,565 kcal</p>
	<ol class="calculator-steps">
		{steps.map(step => <li><div><strong>{step.title}</strong><span>{step.value}</span></div><p class="caption">{step.detail}</p></li>)}
	</ol>
	<figcaption id="calculator-caption" class="caption">Male, age 30, 70 kg, 175 cm, Moderate, Maintain, Balanced. The app calculates the final calories from rounded grams with 4/4/9.</figcaption>
</figure>
