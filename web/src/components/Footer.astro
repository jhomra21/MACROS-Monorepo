---
import { site } from '../data/site';
import { publishedEntries } from '../lib/seo';
import AppStoreBadge from './AppStoreBadge.astro';
import BrandLockup from './BrandLockup.astro';

const posts = await publishedEntries('blog');

// The blog index and feed exist only once a post is published.
const blogOnly = new Set(['/blog/', '/rss.xml']);

const groups = site.footerLinks.map(group => ({
	heading: group.heading,
	links: group.links.filter(link => posts.length > 0 || !blogOnly.has(link.href)),
}));
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<a class="brand" href="/" aria-label={`${site.name} ${site.lockupSubtitle} home`}><BrandLockup /></a>
				<p>{site.tagline}</p>
				<p>
					Email us at <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
				</p>
			</div>
			<div class="site-footer__groups">
				{
					groups.map((group) => (
						<nav aria-label={group.heading}>
							<h2>{group.heading}</h2>
							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))}
							</ul>
						</nav>
					))
				}
			</div>
		</div>
		{Astro.url.pathname !== '/' && <AppStoreBadge />}
		<p class="site-footer__bottom caption">© 2026 {site.fullName}. All rights reserved.</p>
		{site.appStore.live && <p class="caption">Apple and the Apple logo are trademarks of Apple Inc., registered in the U.S. and other countries. App Store is a service mark of Apple Inc.</p>}
	</div>
</footer>
