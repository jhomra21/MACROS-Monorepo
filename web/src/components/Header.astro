---
import { site } from '../data/site';
import { publishedEntries } from '../lib/seo';

const posts = await publishedEntries('blog');

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/" aria-label={`${site.name} home`}>
			<svg class="brand-mark" viewBox="0 0 64 64" fill="none" stroke-width="7" stroke-linecap="round" aria-hidden="true">
				<g transform="rotate(-90 32 32)">
					{['protein', 'carbs', 'fat'].map((name, index) => (
						<>
							<circle class="ring-track" cx="32" cy="32" r={26 - index * 8} />
							<circle class={`ring-fill ring-fill--${name}`} cx="32" cy="32" r={26 - index * 8} pathLength="100" style={`--fill: 70; --ring-i: ${index}`} />
						</>
					))}
				</g>
			</svg>
			<script is:inline>document.querySelectorAll('.brand-mark .ring-fill').forEach(ring => ring.style.setProperty('--fill', (25 + Math.random() * 70) | 0));</script>
			{site.name}
		</a>
		<nav class="site-nav" aria-label="Primary">
			<ul class="nav-list">
				{
					site.navItems.map((item) => (
						<li class:list={[item.secondary && 'nav-item--secondary']}>
							<a class="nav-link" href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
				{posts.length > 0 && <li><a class="nav-link" href="/blog/">Blog</a></li>}
			</ul>
		</nav>
	</div>
</header>
