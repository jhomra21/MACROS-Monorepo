---
import { site } from '../data/site';
import { publishedEntries } from '../lib/seo';
import BrandLockup from './BrandLockup.astro';
import MacroRings from './MacroRings.astro';

const posts = await publishedEntries('blog');

const currentPath = Astro.url.pathname;

// A section link stays marked on its articles too, as aria-current="true" rather than "page".
const current = (href: string) => currentPath === href ? 'page' : !href.includes('#') && currentPath.startsWith(href) ? 'true' : undefined;
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/" aria-label={`${site.name} ${site.lockupSubtitle} home`}>
			<MacroRings class="brand-mark" />
			<script is:inline>document.querySelectorAll('.brand-mark .ring-fill').forEach(ring => ring.style.setProperty('--fill', (25 + Math.random() * 70) | 0));</script>
			<BrandLockup />
		</a>
		<nav class="site-nav" aria-label="Primary">
			<ul class="nav-list">
				{
					site.navItems.map((item) => (
						<li class:list={[item.secondary && 'nav-item--secondary']}>
							<a class="nav-link" href={item.href} aria-current={current(item.href)}>
								{item.label}
							</a>
						</li>
					))
				}
				{posts.length > 0 && <li><a class="nav-link" href="/blog/" aria-current={current('/blog/')}>Blog</a></li>}
			</ul>
		</nav>
	</div>
</header>
