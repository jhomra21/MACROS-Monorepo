---
import { site } from '../data/site';
---

<section class="section" aria-labelledby="download-cta-title">
	<div class="container">
		<div class="download-cta">
			<h2 id="download-cta-title" class="headline">Get MACROS for iPhone.</h2>
			<p class="lead">Download MACROS on the App Store and start tracking without an account.</p>
			<a class="button button--lg" href={site.appStore.url}>Download on the App Store</a>
		</div>
	</div>
</section>
