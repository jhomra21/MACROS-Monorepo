---
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	widths?: number[];
	sizes?: string;
	eager?: boolean;
	small?: boolean;
}

const { src, alt, widths = [280, 560], sizes = '280px', eager = false, small = false } = Astro.props;
---

{/* A plain screenshot: the site must not draw simulated Apple hardware (see web/SEO.md). */}
<div class:list={['app-screen', small && 'app-screen--sm']}>
	{/* `priority` sets loading="eager", decoding="sync", and fetchpriority="high" together. */}
	<Image src={src} alt={alt} format="webp" widths={widths} sizes={sizes} priority={eager || undefined} />
</div>
