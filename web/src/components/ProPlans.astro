---
import { site } from '../data/site';
import ProPrices from './ProPrices.astro';
---

<section id="plans" class="section" aria-labelledby="plans-title">
	<div class="container plans">
		<div class="section-heading">
			<h2 id="plans-title" class="headline">Your food diary is free.</h2>
			<p class="lead">Want a longer view of your progress? That's what Pro is for.</p>
		</div>

		<ProPrices />

		<div class="pro-summary">
			<h3 class="subhead">Pro adds</h3>
			<ul class="pro-summary__features">
				{site.proFeatures.map(feature => <li>{feature}</li>)}
			</ul>
			<p><a href="/pro/">Compare Free and Pro</a></p>
		</div>
	</div>
</section>
