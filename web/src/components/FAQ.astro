---
import { site } from '../data/site';
---

<section id="faq" class="section section--soft" aria-labelledby="faq-title">
	<div class="container faq">
		<div class="section-heading" data-reveal>
			<span class="macro-bar" aria-hidden="true"><i></i><i></i><i></i></span>
			<h2 id="faq-title" class="headline">Common questions.</h2>
			<p class="lead">
				Not answered here? <a href="/support">Ask support</a>.
			</p>
		</div>
		<div class="faq__list" data-reveal>
			{
				site.faq.map((item) => (
					<details class="faq-item">
						<summary>{item.question}</summary>
						<div class="faq-item__body">
							<p>{item.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
