---
import WaitlistForm from './WaitlistForm.astro';

interface Props {
	idPrefix: string;
}

const { idPrefix } = Astro.props;
---

<section class="section" aria-labelledby={`${idPrefix}-cta-title`}>
	<div class="container">
		<div class="waitlist-cta">
			<h2 id={`${idPrefix}-cta-title`} class="headline">Want to try MACROS?</h2>
			<p class="lead">Join the waitlist. We'll email you when it's on the App Store.</p>
			<WaitlistForm idPrefix={idPrefix} />
		</div>
	</div>
</section>
