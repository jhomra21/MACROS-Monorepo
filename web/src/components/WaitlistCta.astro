---
import WaitlistForm from './WaitlistForm.astro';

interface Props {
	idPrefix: string;
}

const { idPrefix } = Astro.props;
---

<section class="section" aria-labelledby={`${idPrefix}-cta-title`}>
	<div class="container">
		<div class="waitlist-cta" data-reveal>
			<h2 id={`${idPrefix}-cta-title`} class="headline">Be there when MACROS launches.</h2>
			<p class="lead">Join the waitlist for the App Store release of MACROS: Nutrition Tracker.</p>
			<WaitlistForm idPrefix={idPrefix} />
		</div>
	</div>
</section>
