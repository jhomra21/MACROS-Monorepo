---
import { site } from '../data/site';
import FeatureGlyph from './FeatureGlyph.astro';
---

<section id="why" class="section" aria-labelledby="why-title">
	<div class="container">
		<div class="section-heading" data-reveal>
			<span class="macro-bar" aria-hidden="true"><i></i><i></i><i></i></span>
			<h2 id="why-title" class="headline">Log fast. Check the numbers. Keep your data.</h2>
			<p class="lead">Quick logging, with every number in view.</p>
		</div>
		<div class="bento">
			{
				site.features.map((feature, index) => (
					<article
						class={`bento__card bento__card--${feature.size} bento__card--${feature.accent}`}
						data-reveal
						style={`--reveal-index: ${index}`}
					>
						<FeatureGlyph glyph={feature.glyph} />
						<p class="eyebrow">{feature.eyebrow}</p>
						<h3 class="title">{feature.title}</h3>
						<p>{feature.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
