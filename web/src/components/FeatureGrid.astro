---
import { site } from '../data/site';
import FeatureGlyph from './FeatureGlyph.astro';
---

<section id="why" class="section" aria-labelledby="why-title">
	<div class="container">
		<div class="section-heading" data-reveal>
			<h2 id="why-title" class="headline">Quick enough to keep doing.</h2>
			<p class="lead">Keep track without making a project of it.</p>
		</div>
		<div class="bento">
			{
				site.features.map((feature, index) => (
					<article
						class={`bento__card bento__card--${feature.size} bento__card--${feature.accent}`}
						data-reveal
						style={`--reveal-index: ${index}`}
					>
						<FeatureGlyph glyph={feature.glyph} />
						<p class="eyebrow">{feature.eyebrow}</p>
						<h3 class="title">{feature.title}</h3>
						<p>{feature.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
