---
import { site } from '../data/site';
import { Picture } from 'astro:assets';

// Container max 1120px; 16px gaps; 24px card padding plus the frame's 1px border.
const imageSizes = {
	wide: '(min-width: 1184px) 597px, (min-width: 900px) calc(58.333vw - 94px), (min-width: 800px) calc(50vw - 90px), (min-width: 640px) calc(46vw - 58px), calc(100vw - 2 * clamp(20px, 4vw, 32px) - 50px)',
	narrow: '(min-width: 1184px) 407px, (min-width: 900px) calc(41.667vw - 86px), (min-width: 800px) calc(50vw - 90px), (min-width: 640px) calc(46vw - 58px), calc(100vw - 2 * clamp(20px, 4vw, 32px) - 50px)',
	half: '(min-width: 1184px) 502px, (min-width: 800px) calc(50vw - 90px), (min-width: 640px) calc(46vw - 58px), calc(100vw - 2 * clamp(20px, 4vw, 32px) - 50px)',
};
---

<section id="why" class="section" aria-labelledby="why-title">
	<div class="container">
		<div class="section-heading">
			<h2 id="why-title" class="headline">Quick enough to keep doing.</h2>
			<p class="lead">Keep track without making a project of it.</p>
		</div>
		<div class="bento">
			{
				site.features.map((feature) => (
					<article class={`bento__card bento__card--${feature.size}`}>
						<div class="bento__image" style={`--image-background: ${feature.background}; --image-ratio: ${feature.image.width} / ${feature.image.height}`}>
							<Picture
								src={feature.image}
								alt={feature.alt}
								formats={['avif', 'webp']}
								fallbackFormat="webp"
								width={feature.image.width}
								height={feature.image.height}
								widths={[320, 480, 640, 960, 1200]}
								sizes={imageSizes[feature.size]}
								loading="lazy"
								decoding="async"
							/>
						</div>
						<h3 class="title">{feature.title}</h3>
						<p>{feature.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
