---
import { site } from '../data/site';
import AppScreen from './AppScreen.astro';
import AppStoreBadge from './AppStoreBadge.astro';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="container hero__grid">
		<div class="hero__copy">
			<h1 id="hero-title" class="display" style="--i: 0">{site.hero.title}</h1>
			<p class="lead" style="--i: 1">{site.hero.lead}</p>
		</div>
		<div class="hero__visual">
			<AppScreen
				src={site.heroShowcase.src}
				alt={site.heroShowcase.alt}
				widths={[240, 280, 320, 480, 560, 640, 840, 960]}
				sizes="(max-width: 899px) 240px, 320px"
				eager
			/>
		</div>
		<div class="hero__signup" id="download">
			<p class="caption">{site.facts.status}</p>
			<AppStoreBadge />
		</div>
	</div>
</section>
