---
import { site } from '../data/site';
import DeviceFrame from './DeviceFrame.astro';
import WaitlistForm from './WaitlistForm.astro';
import AppStoreBadge from './AppStoreBadge.astro';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="container hero__grid">
		<div class="hero__copy">
			<h1 id="hero-title" class="display" style="--i: 0">{site.hero.title}</h1>
			<p class="lead" style="--i: 1">{site.hero.lead}</p>
		</div>
		<div class="hero__visual">
			<DeviceFrame
				src={site.heroShowcase.src}
				alt={site.heroShowcase.alt}
				widths={[240, 280, 320, 480, 560, 640, 840, 960]}
				sizes="(max-width: 899px) 240px, 320px"
				eager
			/>
		</div>
		<div class="hero__signup">
			<p class="caption">Coming to the App Store. Join the waitlist.</p>
			<div class="hero__form">
				<WaitlistForm idPrefix="hero" />
			</div>
			<p class="caption hero__note">
				Your email is only for the waitlist. <a href="/privacy/">Privacy policy</a>.
			</p>
			<AppStoreBadge />
		</div>
	</div>
</section>
