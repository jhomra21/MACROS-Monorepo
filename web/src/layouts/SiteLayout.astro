---
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { absoluteURL, breadcrumbs, pages, publishedEntries } from '../lib/seo';
import type { JsonObject } from '../lib/json';
import { socialImage, socialInput } from '../lib/social';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	article?: { published: Date; updated: Date };
	structuredData?: JsonObject[];
}

const { title, description, noindex = false, article, structuredData = [] } = Astro.props;

const canonicalURL = absoluteURL(Astro.url.pathname);

const entry = article ? (await publishedEntries(Astro.url.pathname.startsWith('/guides/') ? 'guides' : 'blog'))
	.find(entry => `/${entry.collection}/${entry.id}/` === Astro.url.pathname) : undefined;

// The noindex 404 uses the existing home preview, without generating a public 404 image.
const image = socialImage(await socialInput(
	noindex ? '/' : Astro.url.pathname,
	noindex ? pages['/'].title : title,
	noindex ? pages['/'].description : description,
	entry?.data.image,
));

const ogImageURL = absoluteURL(image.src);

const posts = await publishedEntries('blog');

const schema = [
	...(!noindex && Astro.url.pathname !== '/' ? [breadcrumbs(Astro.url.pathname, title.split(' | ')[0])] : []),
	...structuredData,
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		{/* Make the transition opt-in available before external stylesheets load. */}
		<style is:inline>
			@media (prefers-reduced-motion: no-preference) {
				@view-transition { navigation: auto; }
			}
		</style>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{site.appStore.live && <meta name="apple-itunes-app" content={`app-id=${site.appStore.id}`} />}
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		{article && <meta property="article:published_time" content={article.published.toISOString()} />}
		{article && <meta property="article:modified_time" content={article.updated.toISOString()} />}
		<meta property="og:site_name" content={site.fullName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={image.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={image.alt} />
		{posts.length > 0 && <link rel="alternate" type="application/rss+xml" title="MACROS blog" href={absoluteURL('/rss.xml')} />}
		{schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '\\u003c')} />}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			// Adds .is-revealed once per element as it nears the viewport. CSS only hides
			// [data-reveal] when scripting is enabled and reduced motion is not requested.
			function initReveal() {
				const targets = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)');

				if (!('IntersectionObserver' in window)) {
					for (const target of targets) {
						target.classList.add('is-revealed');
					}

					return;
				}

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								const target = entry.target;
								target.classList.add('is-revealed');
								observer.unobserve(target);
								// Drop the reveal transition and delay once settled so later style changes stay instant.
								target.addEventListener('transitionend', (event) => {
									// SAFETY: transitionend listeners always receive a TransitionEvent.
									if (event.target === target && (event as TransitionEvent).propertyName === 'opacity') {
										target.removeAttribute('data-reveal');
										target.classList.remove('is-revealed');
									}
								});
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
				);

				for (const target of targets) {
					observer.observe(target);
				}
			}

			initReveal();
		</script>
	</body>
</html>
