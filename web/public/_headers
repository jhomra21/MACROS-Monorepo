/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

# Media names carry a content hash (see DemoVideo.astro), so a changed file gets a new URL.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed file names change whenever their bytes change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/social/*
  Cache-Control: public, max-age=31536000, immutable

# Alias hosts redirect pages in the Worker but serve existing static files directly.
https://www.macrosios.com/*
  X-Robots-Tag: noindex

https://:worker.jhonra121.workers.dev/*
  X-Robots-Tag: noindex
