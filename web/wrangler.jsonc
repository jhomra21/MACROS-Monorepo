{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macros-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  // Full zod dominates the script; minifying cuts the upload from 797 KiB to 478 KiB.
  "minify": true,
  "upload_source_maps": true,
  // workers.dev stays on so old links reach the Worker and get a 301 to macrosios.com.
  "workers_dev": true,
  "routes": [
    { "pattern": "macrosios.com", "custom_domain": true },
    { "pattern": "www.macrosios.com", "custom_domain": true },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "ratelimits": [
    { "name": "SUPPORT_LIMITER", "namespace_id": "1301", "simple": { "limit": 5, "period": 60 } },
    { "name": "WAITLIST_LIMITER", "namespace_id": "1302", "simple": { "limit": 5, "period": 60 } }
  ],
  "dev": {
    "port": 8787,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    // Misses fall through to the Worker, which redirects www and workers.dev and serves 404.html itself.
    // With "404-page", the asset router would answer misses without the Worker on every host.
    "not_found_handling": "none",
    // Existing pages and feeds run the Worker first so www and workers.dev redirect instead of serving
    // duplicates. Existing static files match no pattern and are served from the asset cache for free.
    // No "!" exclusions: a negative pattern also sends misses straight to the asset router.
    // Keep /media/* reaching the Worker too: static assets ignore Range, and src/lib/byte-range.ts is what
    // answers Safari's bytes=0-1 probe with a 206. A pattern list that skips /media/* would break iPhone playback.
    "run_worker_first": ["/", "/*/", "/sitemap.xml", "/robots.txt", "/rss.xml", "/api/*", "/media/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "issues": {
      "enabled": true,
    },
  },
  "d1_databases": [
    {
      "binding": "SUPPORT_DB",
      "database_name": "cal-macro-tracker-support",
      "database_id": "fde5c0b8-dda4-4c92-b068-baf7e19e3b0e",
      "migrations_dir": "./migrations",
    },
  ],
}
