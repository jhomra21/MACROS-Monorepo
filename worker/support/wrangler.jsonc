{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macros-support",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "routes": [
    { "pattern": "support.macrosios.com", "custom_domain": true }
  ],
  "ratelimits": [
    { "name": "BURST_LIMITER", "namespace_id": "1202", "simple": { "limit": 5, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "REQUEST_LIMITS", "id": "00000000000000000000000000000000" }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "support@macrosios.com",
      "allowed_sender_addresses": ["no-reply@macrosios.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
